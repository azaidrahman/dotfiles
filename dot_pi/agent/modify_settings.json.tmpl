#!/usr/bin/env bash
# chezmoi modify_ script for ~/.pi/agent/settings.json
# Renders the managed settings below, but PRESERVES live dynamic keys:
#   lastChangelogVersion - updated automatically by pi on new releases
#   defaultThinkingLevel - updated via pi settings
# The model list comes from .chezmoidata/pi.yaml. enabledModels holds the
# proxy models (pi.models) and the provider-native models (pi.extra_models).
set -euo pipefail

current=$(cat)
changelog=$(printf '%s' "$current" | jq -r '.lastChangelogVersion // empty' 2>/dev/null || true)
thinking=$(printf '%s' "$current" | jq -r '.defaultThinkingLevel // empty' 2>/dev/null || true)

cat <<'EOF_JSON' | jq --arg changelog "$changelog" --arg thinking "$thinking" \
    '(if $changelog != "" then .lastChangelogVersion = $changelog else . end) | (if $thinking != "" then .defaultThinkingLevel = $thinking else . end)'
{
  "lastChangelogVersion": "0.79.9",
  "defaultProvider": "litellm",
  "defaultModel": {{ .pi.default_model | quote }},
  "defaultThinkingLevel": "xhigh",
  "enabledModels": [
{{- range $i, $m := .pi.models }}
    {{ if $i }}, {{ end }}{{ printf "litellm/%s" $m.id | quote }}
{{- end }}
{{- range .pi.extra_models }}
    , {{ . | quote }}
{{- end }}
  ],
  "packages": [
    "npm:pi-web-access",
    "npm:pi-lens",
    "npm:pi-cache-optimizer",
    "npm:pi-superpowers-plus",
    "npm:taskplane"
  ]
}
EOF_JSON
