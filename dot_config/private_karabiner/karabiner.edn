;; Goku (GokuRakuJoudo) configuration for Karabiner-Elements
;; Generates complex_modifications in ~/.config/karabiner/karabiner.json
;;
;; Note: Device simple_modifications and fn_function_keys are managed
;; by Karabiner UI, not by this file.
;;
;; IMPORTANT: Edit this file, not karabiner.json directly.
;; Run ./generate-help-text.sh to rebuild help text from scripts/*.yaml and run goku.
;;
;; !  | means mandatory
;; #  | means optional
;; C  | left_command
;; T  | left_control
;; O  | left_option
;; S  | left_shift
;; F  | fn
;; Q  | right_command
;; W  | right_control
;; E  | right_option
;; R  | right_shift
;; P  | caps_lock
;; !! | mandatory command + control + optional + shift (hyper)
;; ## | optional any

{:profiles {:Zaid {:default true}}

 :applications {:ghostty-utm ["^com\\.mitchellh\\.ghostty$"
                              "^com\\.utmapp\\.UTM$"]}

 :templates {:open          "open -a '%s'",
             :open-vivaldi  "open -n -a Vivaldi --args --profile-directory='%s'"
             :show-time     "~/.config/karabiner/scripts/show-time.sh"
             :hide-time     "killall time-hud 2>/dev/null"
             ; :cycle-or-open "~/.config/karabiner/scripts/cycle-or-open.sh '%s'"
            }

;; BEGIN HELP-TEXT (auto-generated from scripts/help-text.yaml)
 :tos {:show-app-help {:noti {:id "org.pqrs.notificaion_message_global_shortcut"
                              :text "w:WA, W:messages, e:obsidian, E:todoist, r:arc, t:ghostty, T:quickT, u:conductor, U:superset, i:IINA, I:ytmusic, o:todo, p:teams, a:claude, s:slack, f:cal, F:alfred, g:iPhone, G:safari, k:KM, l:outlook, c:switch, v:vivaldi, V:arc, b:telegram, n:ino, m:spotify"}}
       :clear-app-help {:noti {:id "org.pqrs.notificaion_message_global_shortcut"
                               :text ""}}
       :show-l1-help {:noti {:id "org.pqrs.notificaion_message_layer1"
                             :text "o:1p, p:dot, s:cleanshotx, l:todoist"}}
       :clear-l1-help {:noti {:id "org.pqrs.notificaion_message_layer1"
                              :text ""}}
       :show-l2-help {:noti {:id "org.pqrs.notificaion_message_layer2"
                             :text "o:1p, p:dot, s:cleanshotx, l:todoist"}}
       :clear-l2-help {:noti {:id "org.pqrs.notificaion_message_layer2"
                              :text ""}}
 }
;; END HELP-TEXT

 :main
 [{:des "Global app shortcut"
   :rules
   [;; Layer 1 trigger: Left Shift + Right Option (with hint overlay)
    [:!Sright_option [:show-l1-help ["shortcut-l1" 1]] nil {:afterup [:clear-l1-help ["shortcut-l1" 0]]}]
    ;; Layer 2 trigger: Left Control + Right Option (with hint overlay)
    [:!Tright_option [:show-l2-help ["shortcut-l2" 1]] nil {:afterup [:clear-l2-help ["shortcut-l2" 0]]}]

    ;; Double-tap right_option to show time notification
    [:right_option [:show-time] ["ro-tapped" 1] {:afterup [:hide-time ["ro-tapped" 0]]}]
    ;; Hold right_option to activate app launcher layer (shows key hints overlay)
    [:right_option [:show-app-help ["app-launch" 1] ["ro-tapped" 1]] nil {:afterup [:clear-app-help ["app-launch" 0]] :delayed {:invoked ["ro-tapped" 0] :canceled ["ro-tapped" 0]}}]

;; BEGIN APP-RULES (auto-generated from scripts/help-text.yaml)
    ;; Shifted shortcuts
    [:!Sw [:open "Messages"]              :app-launch]
    [:!Se [:open "Todoist"]               :app-launch]
    [:!St :!TOSf13                        :app-launch]
    [:!Su [:open "Superset"]              :app-launch]
    [:!Si [:open "Youtube Music"]         :app-launch]
    [:!Sf [:open "Alfred Preferences"]    :app-launch]
    [:!Sg [:open "Safari"]                :app-launch]
    [:!Sv [:open "Arc"]                   :app-launch]

    ;; Unshifted shortcuts
    [:w [:open "Whatsapp"]                :app-launch]
    [:e [:open "Obsidian"]                :app-launch]
    [:r [:open "Arc"]                     :app-launch]
    [:t [:open "Ghostty"]                 :app-launch]
    [:u [:open "Conductor"]               :app-launch]
    [:i [:open "IINA"]                    :app-launch]
    [:o [:open "Orbstack"]                :app-launch]
    [:p [:open "Microsoft Teams"]         :app-launch]
    [:a [:open "Claude"]                  :app-launch]
    [:s [:open "Slack"]                   :app-launch]
    [:f [:open "Calendar"]                :app-launch]
    [:g [:open "iPhone Mirroring"]        :app-launch]
    [:k [:open "Keyboard Maestro"]        :app-launch]
    [:l [:open "Microsoft Outlook"]       :app-launch]
    [:c :!Cgrave_accent_and_tilde         :app-launch]
    [:v [:open "Vivaldi"]                 :app-launch]
    [:b [:open "Telegram"]                :app-launch]
    [:n [:open "Inoreader"]               :app-launch]
    [:m [:open "Spotify"]                 :app-launch]
;; END APP-RULES
   ]
  }
  {:des "Hyper Navigation"
   :rules
   [;; h = left
    [:!QWERh      :left_arrow]                                      ;; left
    [:!CQWERh     :!Sleft_arrow]                                    ;; +cmd → select char left
    [:!OCQWERh    :!OSleft_arrow]                                   ;; +opt+cmd → select word left
    [:!SQWERh     :!TStab]                                          ;; +shift → prev tab
    [:!OQWERh     :!Oleft_arrow]                                    ;; +opt → word left

    ;; j = down
    [:!QWERj      :down_arrow]                                      ;; down
    [:!CQWERj     :!Sdown_arrow]                                    ;; +cmd → select line down
    [:!OCQWERj    [:!Sdown_arrow :!Sdown_arrow :!Sdown_arrow]]      ;; +opt+cmd → select 3 lines
    [:!SQWERj     :!Ctab]                                           ;; +shift → next app
    [:!TQWERj     :!Tdown_arrow]                                    ;; +ctrl → app expose

    ;; k = up
    [:!QWERk      :up_arrow]                                        ;; up
    [:!CQWERk     :!Sup_arrow]                                      ;; +cmd → select line up
    [:!OCQWERk    [:!Sup_arrow :!Sup_arrow :!Sup_arrow]]            ;; +opt+cmd → select 3 lines
    [:!SQWERk     :!CStab]                                          ;; +shift → prev app
    ;; m = mission control
    [:!QWERf     :!Tup_arrow]                                      ;; +ctrl → mission control

    ;; l = right
    [:!QWERl      :right_arrow]                                     ;; right
    [:!CQWERl     :!Sright_arrow]                                   ;; +cmd → select char right
    [:!OCQWERl    :!OSright_arrow]                                   ;; +opt+cmd → select word right
    [:!SQWERl     :!Ttab]                                           ;; +shift → next tab
    [:!OQWERl     :!Oright_arrow]                                   ;; +opt → word right

    ;; u = home, p = end
    [:!QWERu      :!Cleft_arrow]                                    ;; home
    [:!CQWERu     :!CSleft_arrow]                                   ;; +cmd → select to home
    [:!QWERp      :!Cright_arrow]                                   ;; end
    [:!CQWERp     :!CSright_arrow]                                  ;; +cmd → select to end

    ;; x = delete
    [:!QWERx      :delete_or_backspace]                             ;; backspace
    [:!SQWERx     :delete_forward]]}                                ;; +shift → forward delete

  {:des "CapsLock to Hyper"
   :rules
   [;; caps_lock → hyper (right modifiers), tap → escape
    [:##caps_lock :!QWEright_shift nil {:alone :escape}]
    ;; hyper+escape → toggle caps_lock
    [:!QWER#Pescape :!Tcaps_lock]
    ;; hyper+space → language switch (ctrl+space)
    [:!QWERspacebar :!Tspacebar]
    ;; hyper+cmd+space → emoji picker (ctrl+cmd+space)
    [:!CQWERspacebar :!TCspacebar]]}

  {:des "Tab to Ctrl"
   :rules
   [;; Tab → Ctrl (hold) / Tab (tap)
    [:##tab :left_control nil {:alone :tab}]]}

  {:des "Backslash double-tap to Notification Centre"
   :rules
   [;; Double-tap \ → Notification Centre (⌘⌃⌥F9)
    [:backslash [:!CTOf9 ["bs-tapped" 0]] ["bs-tapped" 1]]
    [:backslash [:backslash ["bs-tapped" 1]] nil {:delayed {:invoked ["bs-tapped" 0] :canceled ["bs-tapped" 0]}}]]}

  ; {:des "Ghostty/UTM: swap Cmd and Ctrl"
  ;  :rules
  ;  [[:##left_command :left_control :ghostty-utm {:alone :left_command}]
  ;   [:##left_control :left_command :ghostty-utm {:alone :left_control}]]}

  ;; ── Shortcut Layer 1 (Left Shift + Right Option + key) ──────────────
  ;; !S in from consumes the held left_shift so outputs are clean.
  ;; Trigger keys map to F15–F20 × {bare, ctrl, cmd, opt, ctrl+cmd,
  ;; ctrl+opt, cmd+opt, ctrl+cmd+opt} = 48 slots.
  {:des "Shortcut Layer 1 (Shift+RightOpt)"
   :rules
   [;; ─── F15 ───
    [:!Sa   :f15           :shortcut-l1]   ;; a → F15
    [:!Sb   :!Tf15         :shortcut-l1]   ;; b → ctrl+F15
    [:!Sc   :!Cf15         :shortcut-l1]   ;; c → cmd+F15
    [:!Sd   :!Of15         :shortcut-l1]   ;; d → opt+F15
    [:!Se   :!CTf15        :shortcut-l1]   ;; e → ctrl+cmd+F15
    [:!Sf   :!TOf15        :shortcut-l1]   ;; f → ctrl+opt+F15
    [:!Sg   :!COf15        :shortcut-l1]   ;; g → cmd+opt+F15
    [:!Sh   :!CTOf15       :shortcut-l1]   ;; h → ctrl+cmd+opt+F15

    ;; ─── F16 ───
    [:!Si   :f16           :shortcut-l1]   ;; i → F16
    [:!Sj   :!Tf16         :shortcut-l1]   ;; j → ctrl+F16
    [:!Sk   :!Cf16         :shortcut-l1]   ;; k → cmd+F16
    [:!Sl   :!Of16         :shortcut-l1]   ;; l → opt+F16
    [:!Sm   :!CTf16        :shortcut-l1]   ;; m → ctrl+cmd+F16
    [:!Sn   :!TOf16        :shortcut-l1]   ;; n → ctrl+opt+F16
    [:!So   :!COf16        :shortcut-l1]   ;; o → cmd+opt+F16
    [:!Sp   :!CTOf16       :shortcut-l1]   ;; p → ctrl+cmd+opt+F16

    ;; ─── F17 ───
    [:!Sq   :f17           :shortcut-l1]   ;; q → F17
    [:!Sr   :!Tf17         :shortcut-l1]   ;; r → ctrl+F17
    [:!Ss   :!Cf17         :shortcut-l1]   ;; s → cmd+F17
    [:!St   :!Of17         :shortcut-l1]   ;; t → opt+F17
    [:!Su   :!CTf17        :shortcut-l1]   ;; u → ctrl+cmd+F17
    [:!Sv   :!TOf17        :shortcut-l1]   ;; v → ctrl+opt+F17
    [:!Sw   :!COf17        :shortcut-l1]   ;; w → cmd+opt+F17
    [:!Sx   :!CTOf17       :shortcut-l1]   ;; x → ctrl+cmd+opt+F17

    ;; ─── F18 ───
    [:!Sy   :f18           :shortcut-l1]   ;; y → F18
    [:!Sz   :!Tf18         :shortcut-l1]   ;; z → ctrl+F18
    [:!S1   :!Cf18         :shortcut-l1]   ;; 1 → cmd+F18
    [:!S2   :!Of18         :shortcut-l1]   ;; 2 → opt+F18
    [:!S3   :!CTf18        :shortcut-l1]   ;; 3 → ctrl+cmd+F18
    [:!S4   :!TOf18        :shortcut-l1]   ;; 4 → ctrl+opt+F18
    [:!S5   :!COf18        :shortcut-l1]   ;; 5 → cmd+opt+F18
    [:!S6   :!CTOf18       :shortcut-l1]   ;; 6 → ctrl+cmd+opt+F18

    ;; ─── F19 ───
    [:!S7                   :f19           :shortcut-l1]   ;; 7 → F19
    [:!S8                   :!Tf19         :shortcut-l1]   ;; 8 → ctrl+F19
    [:!S9                   :!Cf19         :shortcut-l1]   ;; 9 → cmd+F19
    [:!S0                   :!Of19         :shortcut-l1]   ;; 0 → opt+F19
    [:!Shyphen              :!CTf19        :shortcut-l1]   ;; - → ctrl+cmd+F19
    [:!Sequal_sign          :!TOf19        :shortcut-l1]   ;; = → ctrl+opt+F19
    [:!Sopen_bracket        :!COf19        :shortcut-l1]   ;; [ → cmd+opt+F19
    [:!Sclose_bracket       :!CTOf19       :shortcut-l1]   ;; ] → ctrl+cmd+opt+F19

    ;; ─── F20 ───
    [:!Ssemicolon                   :f20           :shortcut-l1]   ;; ; → F20
    [:!Squote                       :!Tf20         :shortcut-l1]   ;; ' → ctrl+F20
    [:!Scomma                       :!Cf20         :shortcut-l1]   ;; , → cmd+F20
    [:!Speriod                      :!Of20         :shortcut-l1]   ;; . → opt+F20
    [:!Sslash                       :!CTf20        :shortcut-l1]   ;; / → ctrl+cmd+F20
    [:!Sbackslash                   :!TOf20        :shortcut-l1]   ;; \ → ctrl+opt+F20
    [:!Sgrave_accent_and_tilde      :!COf20        :shortcut-l1]   ;; ` → cmd+opt+F20
    [:!Sspacebar                    :!CTOf20       :shortcut-l1]   ;; space → ctrl+cmd+opt+F20
   ]}

  ;; ── Shortcut Layer 2 (Left Ctrl + Right Option + key) ─────────────
  ;; !T in from consumes the held left_control.
  ;; Outputs mirror Layer 1 but with shift added.
  {:des "Shortcut Layer 2 (Ctrl+RightOpt)"
   :rules
   [;; ─── F15 ───
    [:!Ta   :!Sf15         :shortcut-l2]   ;; a → shift+F15
    [:!Tb   :!TSf15        :shortcut-l2]   ;; b → ctrl+shift+F15
    [:!Tc   :!CSf15        :shortcut-l2]   ;; c → cmd+shift+F15
    [:!Td   :!OSf15        :shortcut-l2]   ;; d → opt+shift+F15
    [:!Te   :!CTSf15       :shortcut-l2]   ;; e → ctrl+cmd+shift+F15
    [:!Tf   :!TOSf15       :shortcut-l2]   ;; f → ctrl+opt+shift+F15
    [:!Tg   :!COSf15       :shortcut-l2]   ;; g → cmd+opt+shift+F15
    [:!Th   :!CTOSf15      :shortcut-l2]   ;; h → ctrl+cmd+opt+shift+F15

    ;; ─── F16 ───
    [:!Ti   :!Sf16         :shortcut-l2]   ;; i → shift+F16
    [:!Tj   :!TSf16        :shortcut-l2]   ;; j → ctrl+shift+F16
    [:!Tk   :!CSf16        :shortcut-l2]   ;; k → cmd+shift+F16
    [:!Tl   :!OSf16        :shortcut-l2]   ;; l → opt+shift+F16
    [:!Tm   :!CTSf16       :shortcut-l2]   ;; m → ctrl+cmd+shift+F16
    [:!Tn   :!TOSf16       :shortcut-l2]   ;; n → ctrl+opt+shift+F16
    [:!To   :!COSf16       :shortcut-l2]   ;; o → cmd+opt+shift+F16
    [:!Tp   :!CTOSf16      :shortcut-l2]   ;; p → ctrl+cmd+opt+shift+F16

    ;; ─── F17 ───
    [:!Tq   :!Sf17         :shortcut-l2]   ;; q → shift+F17
    [:!Tr   :!TSf17        :shortcut-l2]   ;; r → ctrl+shift+F17
    [:!Ts   :!CSf17        :shortcut-l2]   ;; s → cmd+shift+F17
    [:!Tt   :!OSf17        :shortcut-l2]   ;; t → opt+shift+F17
    [:!Tu   :!CTSf17       :shortcut-l2]   ;; u → ctrl+cmd+shift+F17
    [:!Tv   :!TOSf17       :shortcut-l2]   ;; v → ctrl+opt+shift+F17
    [:!Tw   :!COSf17       :shortcut-l2]   ;; w → cmd+opt+shift+F17
    [:!Tx   :!CTOSf17      :shortcut-l2]   ;; x → ctrl+cmd+opt+shift+F17

    ;; ─── F18 ───
    [:!Ty   :!Sf18         :shortcut-l2]   ;; y → shift+F18
    [:!Tz   :!TSf18        :shortcut-l2]   ;; z → ctrl+shift+F18
    [:!T1   :!CSf18        :shortcut-l2]   ;; 1 → cmd+shift+F18
    [:!T2   :!OSf18        :shortcut-l2]   ;; 2 → opt+shift+F18
    [:!T3   :!CTSf18       :shortcut-l2]   ;; 3 → ctrl+cmd+shift+F18
    [:!T4   :!TOSf18       :shortcut-l2]   ;; 4 → ctrl+opt+shift+F18
    [:!T5   :!COSf18       :shortcut-l2]   ;; 5 → cmd+opt+shift+F18
    [:!T6   :!CTOSf18      :shortcut-l2]   ;; 6 → ctrl+cmd+opt+shift+F18

    ;; ─── F19 ───
    [:!T7                   :!Sf19         :shortcut-l2]   ;; 7 → shift+F19
    [:!T8                   :!TSf19        :shortcut-l2]   ;; 8 → ctrl+shift+F19
    [:!T9                   :!CSf19        :shortcut-l2]   ;; 9 → cmd+shift+F19
    [:!T0                   :!OSf19        :shortcut-l2]   ;; 0 → opt+shift+F19
    [:!Thyphen              :!CTSf19       :shortcut-l2]   ;; - → ctrl+cmd+shift+F19
    [:!Tequal_sign          :!TOSf19       :shortcut-l2]   ;; = → ctrl+opt+shift+F19
    [:!Topen_bracket        :!COSf19       :shortcut-l2]   ;; [ → cmd+opt+shift+F19
    [:!Tclose_bracket       :!CTOSf19      :shortcut-l2]   ;; ] → ctrl+cmd+opt+shift+F19

    ;; ─── F20 ───
    [:!Tsemicolon                   :!Sf20         :shortcut-l2]   ;; ; → shift+F20
    [:!Tquote                       :!TSf20        :shortcut-l2]   ;; ' → ctrl+shift+F20
    [:!Tcomma                       :!CSf20        :shortcut-l2]   ;; , → cmd+shift+F20
    [:!Tperiod                      :!OSf20        :shortcut-l2]   ;; . → opt+shift+F20
    [:!Tslash                       :!CTSf20       :shortcut-l2]   ;; / → ctrl+cmd+shift+F20
    [:!Tbackslash                   :!TOSf20       :shortcut-l2]   ;; \ → ctrl+opt+shift+F20
    [:!Tgrave_accent_and_tilde      :!COSf20       :shortcut-l2]   ;; ` → cmd+opt+shift+F20
    [:!Tspacebar                    :!CTOSf20      :shortcut-l2]   ;; space → ctrl+cmd+opt+shift+F20
   ]}
  ]
}
