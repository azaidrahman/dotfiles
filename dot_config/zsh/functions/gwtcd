# gwtcd - cd into a git worktree
#   gwtcd <name>   cd into worktree by basename (tab-completable)
#   gwtcd          fuzzy-pick with fzf

local target="$1" match
if [[ -z "$target" ]]; then
  match=$(git worktree list | awk '{print $1}' | while read -r p; do
    printf "%s\t%s\n" "$(basename "$p")" "$p"
  done | fzf --with-nth=1 | cut -f2)
else
  match=$(git worktree list | awk '{print $1}' | while read -r p; do
    [[ "$(basename "$p")" == "$target" ]] && { echo "$p"; break; }
  done)
fi
[[ -n "$match" ]] && cd "$match"
