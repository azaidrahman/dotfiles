# pi - Pi coding agent through the LiteLLM proxy on onyx (Vertex AI).
#      Shadows the `pi` binary. Provider and default model come from
#      ~/.pi/agent/settings.json; this wrapper only:
#        1. fetches the 'omp' virtual key from 1Password and health-checks
#           the proxy (_litellm_proxy), which the litellm-provider extension
#           reads from $LITELLM_API_KEY
#
#   pi [pi-args...]                 e.g. pi --model claude-opus-4-8
#   pi --resume                     resume the most recent session
#   command pi                      raw binary, no proxy guard
emulate -L zsh

_litellm_proxy omp || return $?

command pi "$@"
