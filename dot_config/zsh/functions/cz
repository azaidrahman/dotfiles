# cz - chezmoi wrapper with git sync shortcut
#
# Extra subcommands:
#   cz push [msg...]     Stage all, commit, and push to remote
#                        Each argument becomes a paragraph: cz push "title" "body"
#
# All other commands pass through to chezmoi.

case "$1" in
    push)
        shift
        if [[ "$1" == "--help" || "$1" == "-h" ]]; then
            cat <<'HELP'
Usage: cz push [msg...]

Stage all chezmoi source changes, commit, and push to remote.
Each argument becomes a separate paragraph in the commit message.

Examples:
  cz push                              Commit with "chore: update dotfiles"
  cz push "feat(zsh): add cz wrapper"  Commit with custom message
  cz push "title" "body details"       Multiline commit (title + body)

If there are no changes but unpushed commits, pushes to remote.
HELP
            return 0
        fi
        local src="$HOME/.local/share/chezmoi"
        local commit_args=()
        if [[ $# -eq 0 ]]; then
            commit_args=(-m "chore: update dotfiles")
        else
            for arg in "$@"; do
                commit_args+=(-m "$arg")
            done
        fi

        if ! git -C "$src" diff --quiet || ! git -C "$src" diff --cached --quiet || [[ -n "$(git -C "$src" ls-files --others --exclude-standard)" ]]; then
            git -C "$src" add -A \
            && git -C "$src" commit "${commit_args[@]}" \
            && git -C "$src" push \
            && echo "\033[32m[cz]\033[0m pushed: ${1:-chore: update dotfiles}" \
            || { echo "\033[31m[cz]\033[0m commit/push failed"; return 1; }
        else
            # Nothing to commit, just push if ahead
            if git -C "$src" status -sb | grep -q 'ahead'; then
                git -C "$src" push \
                && echo "\033[32m[cz]\033[0m pushed to remote" \
                || { echo "\033[31m[cz]\033[0m push failed"; return 1; }
            else
                echo "\033[33m[cz]\033[0m nothing to commit or push"
            fi
        fi
        ;;
    update)
        shift
        # Pull latest source, then SHOW pending changes and stop — do NOT auto-apply.
        # Why: `chezmoi apply` can hang the shell ("zsh: suspended (tty output)") when a
        # locally-modified target triggers chezmoi's overwrite prompt and a run_onchange
        # script (e.g. goku) fires between prompts (SIGTTOU). Review, reconcile any
        # externally-edited targets, then run `cz apply` deliberately.
        command chezmoi git -- pull --autostash --rebase || return 1
        local status_out
        status_out="$(command chezmoi status)"
        echo "\033[34m[cz]\033[0m source updated — pending changes:"
        [[ -n "$status_out" ]] && print -r -- "$status_out"

        # Karabiner's edn is generated; a binding only goes live once goku recompiles
        # karabiner.json. If this update touched anything under karabiner, offer to apply
        # just that subtree and recompile. Scoping the apply to ~/.config/karabiner avoids
        # the global SIGTTOU hang described above; the explicit goku run doesn't trust the
        # hash-gated run_onchange hook to have fired against the fresh edn.
        if grep -q 'karabiner' <<< "$status_out"; then
            echo -n "\033[34m[cz]\033[0m karabiner config changed — apply it and run goku now? [y/N] "
            if read -q; then
                echo
                command chezmoi apply "$HOME/.config/karabiner" \
                && GOKU_EDN_CONFIG_FILE="$HOME/.config/karabiner/karabiner.edn" goku \
                && echo "\033[32m[cz]\033[0m goku recompiled karabiner.json" \
                || { echo "\033[31m[cz]\033[0m apply/goku failed"; return 1; }
            else
                echo
            fi
        fi
        echo "\033[33m[cz]\033[0m review above, then run 'cz apply' (reconcile 'M' targets first: 'cz re-add <file>' keeps your edit, 'cz apply --force <file>' discards it)"
        ;;
    *)
        command chezmoi "$@"
        ;;
esac
