# ,gcp-iam-check - List IAM roles for a member on a GCP project
#
# Usage:
#   ,gcp-iam-check <project-id> <member>
#
# Examples:
#   ,gcp-iam-check gtech-agent-svc-dev terraform-sa@gtech-infra-core.gamuda.tech
#   ,gcp-iam-check gtech-infra-core user:alice@gamuda.tech

if [[ $# -lt 2 ]]; then
  echo "Usage: ,gcp-iam-check <project-id> <member>"
  echo ""
  echo "Examples:"
  echo "  ,gcp-iam-check gtech-agent-svc-dev terraform-sa@gtech-infra-core.gamuda.tech"
  echo "  ,gcp-iam-check gtech-infra-core user:alice@gamuda.tech"
  return 1
fi

local project="$1"
local member="$2"

echo "Project: ${project}"
echo "Member:  ${member}"
echo ""

gcloud projects get-iam-policy "${project}" \
  --flatten="bindings[].members" \
  --format="table(bindings.role)" \
  --filter="bindings.members:${member}"
