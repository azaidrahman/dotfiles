{{- /* Headless hosts run plain stock tmux (no theme plugin, no visual.conf).
       Keep this list in sync with dot_tmux.conf.tmpl (the loader). */ -}}
{{- $headless := list -}}
{{- $minimal := has .chezmoi.hostname $headless -}}
# Plugins + TPM. The theme plugin is skipped on headless/minimal hosts.

# PATH so TPM and plugin scripts find homebrew + system binaries
set-environment -g PATH '/opt/homebrew/bin:/bin:/usr/bin'

# --- Functional plugins (always loaded) ---
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @continuum-restore 'on'
# Auto-save every minute (default is 15) so a crash restores a near-current
# session rather than one up to 15 min stale. Resurrect saves are cheap text.
set -g @continuum-save-interval '1'

# Tmux-jump to character (https://github.com/schasse/tmux-jump)
set -g @plugin 'schasse/tmux-jump'
set -g @jump-key 'g'

# Open URLs and files from copy-mode with o / C-o
set -g @plugin 'tmux-plugins/tmux-open'

{{ if not $minimal -}}
# --- Theme (visual; skipped on minimal hosts) ---
# https://github.com/janoamaral/tokyo-night-tmux
set -g @plugin "janoamaral/tokyo-night-tmux"
set -g @tokyo-night-tmux_show_wbg 0
set -g @tokyo-night-tmux_show_hostname 1
set -g @tokyo-night-tmux_transparent 1
set -g @tokyo-night-tmux_theme storm
set -g @tokyo-night-tmux_window_id_style none
set -g @tokyo-night-tmux_show_datetime 1
# date format handled by custom scripts/datetime-widget.sh (DD/MM/YY); plugin only offers DMY/MDY/YMD with 4-digit year
# set -g @tokyo-night-tmux_date_format DMY
set -g @tokyo-night-tmux_time_format 12H
set -g @tokyo-night-tmux_show_git 1
set -g @tokyo-night-tmux_show_path 1
set -g @tokyo-night-tmux_path_format relative
set -g @tokyo-night-tmux_path_max_length 30
{{ end -}}

# Initialize TPM (must run after all @plugin declarations)
run '~/.tmux/plugins/tpm/tpm'
