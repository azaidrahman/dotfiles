# SSH: change tmux pane background so remote sessions look different
ssh() {
  if [ -n "$TMUX" ]; then
    tmux select-pane -P 'bg=#200000'
    tmux set -p window-style 'bg=#200000'
    tmux set -p window-active-style 'bg=#501515'
  fi
  command ssh "$@"
  if [ -n "$TMUX" ]; then
    tmux select-pane -P 'default'
    tmux set -pu window-style
    tmux set -pu window-active-style
  fi
}

# Docker completion
docker () {
    unfunction docker
    FPATH="$HOME/.docker/completions:$FPATH"
    autoload -Uz compinit
    compinit
    docker "$@"
}

