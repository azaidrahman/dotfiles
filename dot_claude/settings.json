{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(fd *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(ls *)",
      "WebSearch",
      "WebFetch"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/allow-readonly.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify-tmux.sh permission_prompt"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify-tmux.sh idle_prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify-tmux.sh stop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify-tmux.sh working"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "jq -r '[ .model.display_name, \"ctx:\\(.context_window.used_percentage // 0)%\", (if .worktree.name then \"wt:\\(.worktree.name)\" else null end), (if .worktree.branch then \"br:\\(.worktree.branch)\" else null end), (if .rate_limits.five_hour then (if .rate_limits.five_hour.used_percentage > 50 then \"5h:\\(.rate_limits.five_hour.used_percentage | round)% (back at \\(.rate_limits.five_hour.resets_at | strflocaltime(\"%H:%M\")))\" else \"5h:\\(.rate_limits.five_hour.used_percentage | round)%\" end) else null end), (if .rate_limits.seven_day then \"7d:\\(.rate_limits.seven_day.used_percentage | round)%\" else null end) ] | map(select(. != null)) | join(\"  |  \")'"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true,
    "meta@gtech-skills": true,
    "platform@gtech-skills": true,
    "general@gtech-skills": true
  },
  "extraKnownMarketplaces": {
    "gtech-skills": {
      "source": {
        "source": "git",
        "url": "https://bitbucket.org/get-rnd/gtech-skills.git"
      }
    }
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "preferredNotifChannel": "ghostty",
  "skipAutoPermissionPrompt": true
}
