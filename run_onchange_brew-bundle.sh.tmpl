#!/bin/bash
# Brewfile hash: {{ include (joinPath .chezmoi.sourceDir "dot_config/homebrew/Brewfile.tmpl") | sha256sum }}

set -euo pipefail

BREWFILE="${HOME}/.config/homebrew/Brewfile"
IGNOREFILE="${HOME}/.config/homebrew/brewignore"

# Build skip lists from brewignore (applied to both install and cleanup)
CASK_SKIP=""
BREW_SKIP=""
if [[ -f "$IGNOREFILE" ]]; then
    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line// }" ]] && continue
        if [[ "$line" =~ ^cask[[:space:]]+(.+) ]]; then
            CASK_SKIP="${CASK_SKIP:+$CASK_SKIP }${BASH_REMATCH[1]}"
        elif [[ "$line" =~ ^brew[[:space:]]+(.+) ]]; then
            BREW_SKIP="${BREW_SKIP:+$BREW_SKIP }${BASH_REMATCH[1]}"
        fi
    done < "$IGNOREFILE"
fi

export HOMEBREW_BUNDLE_CASK_SKIP="$CASK_SKIP"
export HOMEBREW_BUNDLE_BREW_SKIP="$BREW_SKIP"

# Show what would be installed and ask for confirmation
install_list=$(brew bundle check --verbose --no-upgrade --file="$BREWFILE" 2>/dev/null | grep -v '^The Brewfile' || true)

if [[ -n "$install_list" ]]; then
    echo "The following packages from your Brewfile are missing:"
    echo "$install_list"
    echo ""
    printf "Install these packages? [y/N] "
    read -r answer </dev/tty
    if [[ "$answer" =~ ^[Yy]$ ]]; then
        echo "Running brew bundle install (no-upgrade: skips upgrades to avoid sudo-needy casks hanging apply)..."
        brew bundle install --no-upgrade --file="$BREWFILE"
    else
        echo "Skipping install."
    fi
else
    echo "All Brewfile packages already installed."
fi

# Show what would be removed and ask for confirmation
cleanup_list=$(brew bundle cleanup --file="$BREWFILE" 2>/dev/null || true)

if [[ -n "$cleanup_list" ]]; then
    echo ""
    echo "The following packages are not in your Brewfile:"
    echo "$cleanup_list"
    echo ""
    printf "Uninstall these packages? [y/N] "
    read -r answer </dev/tty
    if [[ "$answer" =~ ^[Yy]$ ]]; then
        brew bundle cleanup --file="$BREWFILE" --force
    else
        echo "Skipping cleanup."
    fi
else
    echo "No packages to clean up."
fi
