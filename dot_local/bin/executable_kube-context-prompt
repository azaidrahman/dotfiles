#!/bin/sh
# Starship custom module: current kube context, shortened.
# Reads current-context straight from the kubeconfig (no `kubectl` call) and
# caches the result keyed on the kubeconfig's mtime, so repeated prompt draws
# reuse the cache instead of re-parsing/filtering every time.
#
# Edit STOPWORDS to drop more boilerplate segments from cluster names, e.g.
# gtech-svc-obs-prd -> obs-prd
STOPWORDS="gtech svc"

kubeconfig="${KUBECONFIG:-$HOME/.kube/config}"
[ -f "$kubeconfig" ] || exit 0

cache="${TMPDIR:-/tmp}/starship-kube-context-cache"
mtime=$(stat -f %m "$kubeconfig" 2>/dev/null || stat -c %Y "$kubeconfig" 2>/dev/null)

if [ -f "$cache" ]; then
  cached_mtime=$(head -n 1 "$cache")
  if [ "$cached_mtime" = "$mtime" ]; then
    tail -n +2 "$cache"
    exit 0
  fi
fi

ctx=$(awk -F': ' '/^current-context:/{print $2}' "$kubeconfig")
[ -z "$ctx" ] && exit 0

cluster="${ctx##*_}"

result=""
for word in $(printf '%s' "$cluster" | tr '-' ' '); do
  skip=0
  for stop in $STOPWORDS; do
    [ "$word" = "$stop" ] && skip=1 && break
  done
  [ "$skip" = 0 ] && result="${result:+$result-}$word"
done
[ -z "$result" ] && result="$cluster"

{
  echo "$mtime"
  echo "$result"
} > "$cache"

printf '%s' "$result"
