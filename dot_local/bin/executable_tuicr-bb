#!/usr/bin/env bash
#
# tuicr-bb - Review Bitbucket pull requests in tuicr, push the comments back
#            with bkt (github.com/avivsinai/bitbucket-cli).
#
# tuicr has no Bitbucket forge backend: `ForgeKind` is a closed GitHub|GitLab
# enum matched across 5 files outside src/forge/*, and a real backend is
# ~2k lines mirroring src/forge/gitlab/glab.rs. This script deliberately adds
# zero Rust and zero patches to tuicr - it drives the two interfaces tuicr
# already exposes:
#
#   read  : `bkt pr checkout` + `tuicr -r <dest>...<head>` (merge-base range)
#   write : `tuicr review comments --session <slug>` -> JSON -> `bkt pr comment`
#
# Design decisions worth knowing before you edit this:
#
#   * Push is DRY-RUN BY DEFAULT. `--push` executes. This writes to real PRs
#     that other people read, so the safe mode is the default mode.
#   * Dedupe is a ledger of tuicr comment ids under $LEDGER_DIR, keyed by
#     session slug. It lives beside tuicr's own sessions
#     (~/.local/share/tuicr/reviews) rather than in .git/, so the ledger and
#     the session it guards have the same lifetime - a .git/ ledger would be
#     lost on re-clone while the session survived, and everything would
#     double-post. The ledger is the ONLY dedupe mechanism: tuicr's
#     `lifecycle_state` stays `local_draft` forever on this path, because only
#     tuicr's real forge submit pipeline transitions it.
#   * Push refuses when the PR head has moved since you reviewed
#     (`--force` overrides). Silent mis-anchoring is worse than no comment:
#     a comment landing on the wrong line reads as deliberate.
#   * Bitbucket cannot represent everything tuicr can. Nothing is ever
#     silently dropped - unmappable comments DEGRADE visibly:
#       - file-level (no line) -> general comment, body prefixed `path`:
#         (bkt requires --from-line/--to-line alongside --file)
#       - line ranges -> anchored at start_line, body prefixed "L12-L18: "
#     ASCII hyphen in that prefix, not an en dash - gtech-docs lints for those.
#
# Known limitations, accepted knowingly:
#   * A force-push to the PR changes the range, hence the slug, hence the
#     session AND the ledger. Re-authored comments can post again.
#   * Nuking ~/.local/share loses dedupe state.
#   * True file-level comments are deferred - Bitbucket's API may accept a
#     path-only inline anchor via `bkt api`, unverified.
#   * Verified against bkt 0.30.0, Bitbucket Cloud. DC is untested; the jq
#     paths fall back to DC field names but nothing here has been run on DC.
#
# Not two-way: existing Bitbucket discussion is not pulled into the TUI.
# Injected remote comments would be indistinguishable from your own drafts in
# the session file, so push would re-post other people's comments.
#

set -euo pipefail

VERSION="0.1.0"
LEDGER_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/tuicr-bkt"

RED='\033[0;31m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
DIM='\033[2m'
NC='\033[0m'

usage() {
    cat <<'EOF'
Usage: tuicr-bb start [<pr-id>]
       tuicr-bb push  [<pr-id>] [--push] [--force] [--no-type-prefix] [--pending]

Review a Bitbucket pull request in tuicr, then push the comments back with bkt.

Commands:
  start [<pr-id>]   Fetch both refs, check out the PR, open it in tuicr.
                    Reviews the merge-base range (the PR's own changes).
  push  [<pr-id>]   Map the session's comments onto `bkt pr comment`.
                    DRY RUN unless --push is passed.

  <pr-id> is inferred from the current branch (pr/<N>) when omitted.

Options (push):
  --push              Actually post. Without it, print the commands only.
  --force             Post even if the PR head moved since you reviewed.
  --no-type-prefix    Don't prepend "[TYPE] " to comment bodies.
                      (tuicr's own comment_type_prefix defaults to true.)
  --pending           Post inline comments as pending/draft review feedback.
                      Passed through to bkt; not applied to general comments.

Options (any):
  -h, --help          Show this help
  -v, --version       Show version

Environment:
  XDG_DATA_HOME       Ledger root (default ~/.local/share), see tuicr-bkt/

Examples:
  tuicr-bb start 142        # check out PR 142 and review it
  tuicr-bb push 142         # dry run: show what would be posted
  tuicr-bb push --push      # from inside pr/142, actually post
EOF
}

error()   { printf "${RED}Error:${NC} %s\n" "$1" >&2; exit 1; }
warn()    { printf "${YELLOW}Warning:${NC} %s\n" "$1" >&2; }
success() { printf "${GREEN}%s${NC}\n" "$1"; }
info()    { printf "${DIM}%s${NC}\n" "$1" >&2; }

need_cmd() {
    command -v "$1" >/dev/null 2>&1 || error "$1 not found. $2"
}

# Shell-quote for the dry run. Single quotes rather than printf %q, which is
# paste-safe but unreadable once a comment body has spaces and punctuation -
# and reading the bodies is the whole point of the dry run.
shq() {
    local s="$1"
    if [[ "$s" =~ ^[A-Za-z0-9_./:=-]+$ ]]; then
        printf '%s' "$s"
    else
        printf "'%s'" "${s//\'/\'\\\'\'}"
    fi
}

preflight() {
    need_cmd git "Install git."
    need_cmd jq "brew install jq"
    need_cmd tuicr "cargo install tuicr, or brew install tuicr"
    need_cmd bkt "brew install avivsinai/tap/bitbucket-cli"
    if ! bkt auth status >/dev/null 2>&1; then
        error "bkt is not authenticated. Run: bkt auth login <host>"
    fi
    git rev-parse --git-dir >/dev/null 2>&1 || error "not inside a git repository"
}

# PR id from an explicit argument, else from a pr/<N> branch name.
resolve_pr_id() {
    local explicit="${1:-}"
    if [[ -n "$explicit" ]]; then
        [[ "$explicit" =~ ^[0-9]+$ ]] || error "PR id must be numeric, got: $explicit"
        printf '%s' "$explicit"
        return
    fi
    local branch
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    if [[ "$branch" =~ ^pr/([0-9]+)$ ]]; then
        printf '%s' "${BASH_REMATCH[1]}"
        return
    fi
    error "no PR id given and branch '$branch' is not pr/<N>. Pass the id explicitly."
}

# `bkt pr view <id> --json`, cached per invocation.
PR_JSON=""
pr_json() {
    local id="$1"
    if [[ -z "$PR_JSON" ]]; then
        PR_JSON=$(bkt pr view "$id" --json) \
            || error "bkt pr view $id failed. Wrong repo, or no such PR?"
    fi
    printf '%s' "$PR_JSON"
}

# `bkt pr view --json` wraps the PR in a {"pull_request": {...}} envelope, the
# same way `pr list` wraps in "pull_requests". `.pull_request // .` unwraps it
# and still works if a future bkt returns the object bare. Cloud field names
# first, Data Center names as fallback.
#
# Verified against bkt 0.30.0 / Bitbucket Cloud: source.commit.hash comes back
# ABBREVIATED (12 chars), not a full 40-char SHA - the drift check truncates
# both sides to the slug's 7-char short SHA, so this is handled.
pr_dest_branch() {
    pr_json "$1" | jq -r '(.pull_request // .)
        | .destination.branch.name // .toRef.displayId // empty'
}

pr_head_sha() {
    pr_json "$1" | jq -r '(.pull_request // .)
        | .source.commit.hash // .fromRef.latestCommit // empty'
}

cmd_start() {
    # Preflight before resolving the id, so a missing tool or an unauthenticated
    # bkt reports itself instead of surfacing as a confusing branch-name error.
    preflight
    local id
    id=$(resolve_pr_id "${1:-}")

    local dest
    dest=$(pr_dest_branch "$id")
    [[ -n "$dest" ]] || error "could not read the destination branch from 'bkt pr view $id --json'"

    # bkt pr checkout only fetches the SOURCE branch. Without a fresh
    # destination ref the merge-base is stale and the diff is wrong.
    # Explicit refspec (forced) so origin/<dest> is definitely updated even if
    # dest was force-pushed.
    info "fetching origin/$dest"
    git fetch --quiet origin "+${dest}:refs/remotes/origin/${dest}" \
        || error "git fetch of origin/$dest failed"

    info "checking out PR $id"
    bkt pr checkout "$id" >/dev/null || error "bkt pr checkout $id failed"

    local range="origin/${dest}...pr/${id}"
    info "reviewing $range"
    exec tuicr -r "$range"
}

# The session slug for this PR. Local slugs look like
#   [<owner>/]<repo>@<anchor>/commits/<base>..<head>
# and `bkt pr checkout` names the branch pr/<id>, which tuicr sanitizes to the
# anchor pr-<id> (slashes become dashes).
resolve_slug() {
    local id="$1"
    local slugs count
    slugs=$(tuicr review list --repo . \
        | jq -r --arg pat "@pr-${id}/" '.[] | select(.slug | contains($pat)) | .slug')
    count=$(printf '%s' "$slugs" | grep -c . || true)

    if [[ "$count" -eq 0 ]]; then
        error "no tuicr session found for PR $id. Run 'tuicr-bb start $id' first."
    fi
    if [[ "$count" -gt 1 ]]; then
        printf 'Multiple sessions match PR %s:\n' "$id" >&2
        printf '%s\n' "$slugs" >&2
        error "ambiguous session. Pass the slug to 'tuicr review comments' by hand."
    fi
    printf '%s' "$slugs"
}

# Short head SHA out of the slug's commits/<base>..<head> segment.
slug_head_sha() {
    printf '%s' "${1##*..}"
}

check_head_drift() {
    local id="$1" slug="$2" force="$3"
    local reviewed current

    reviewed=$(slug_head_sha "$slug")
    current=$(pr_head_sha "$id")
    if [[ -z "$current" ]]; then
        warn "could not read the PR head SHA; skipping the drift check"
        return
    fi
    current="${current:0:${#reviewed}}"

    if [[ "$reviewed" == "$current" ]]; then
        return
    fi
    if [[ "$force" == "1" ]]; then
        warn "PR head moved ($reviewed -> $current); posting anyway because --force"
        return
    fi
    printf '%b\n' "${RED}Error:${NC} the PR head moved since you reviewed it." >&2
    printf '  reviewed: %s\n' "$reviewed" >&2
    printf '  current:  %s\n' "$current" >&2
    printf '\nYour line anchors may be wrong. Re-run: tuicr-bb start %s\n' "$id" >&2
    printf 'Or override with --force if you know the lines still line up.\n' >&2
    exit 1
}

cmd_push() {
    local id_arg="" do_push=0 force=0 type_prefix=1 pending=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --push)           do_push=1; shift ;;
            --dry-run)        do_push=0; shift ;;
            --force)          force=1; shift ;;
            --no-type-prefix) type_prefix=0; shift ;;
            --pending)        pending=1; shift ;;
            -*)               error "unknown option for push: $1" ;;
            *)                id_arg="$1"; shift ;;
        esac
    done

    preflight
    local id
    id=$(resolve_pr_id "$id_arg")

    local slug
    slug=$(resolve_slug "$id")
    info "session: $slug"

    check_head_drift "$id" "$slug" "$force"

    local ledger
    mkdir -p "$LEDGER_DIR"
    ledger="${LEDGER_DIR}/$(printf '%s' "$slug" | tr '/@:' '---').posted"
    touch "$ledger"

    # Review-level comments first so they read as the summary at the top of the
    # PR, then inline comments by path, then by line.
    local comments
    comments=$(tuicr review comments --session "$slug" --repo . \
        | jq -c 'sort_by([(if .path == null then 0 else 1 end),
                          (.path // ""),
                          (.start_line // 0)]) | .[]')

    if [[ -z "$comments" ]]; then
        success "no comments in session $slug - nothing to push."
        return
    fi

    local posted=0 skipped=0 failed=0 degraded=0

    while IFS= read -r comment; do
        [[ -n "$comment" ]] || continue

        local cid ctype content path start_line end_line side
        cid=$(printf '%s' "$comment"        | jq -r '.id')
        ctype=$(printf '%s' "$comment"      | jq -r '.comment_type // "none"')
        content=$(printf '%s' "$comment"    | jq -r '.content')
        path=$(printf '%s' "$comment"       | jq -r '.path // empty')
        start_line=$(printf '%s' "$comment" | jq -r '.start_line // empty')
        end_line=$(printf '%s' "$comment"   | jq -r '.end_line // empty')
        side=$(printf '%s' "$comment"       | jq -r '.side // "new"')

        if grep -Fqx "$cid" "$ledger"; then
            skipped=$((skipped + 1))
            continue
        fi

        # Body prefixes, outermost first: [TYPE] then the degradation note.
        local body="$content"

        if [[ -n "$path" && -z "$start_line" ]]; then
            # File-level: bkt requires a line alongside --file, so this becomes
            # a general comment carrying the path in the body.
            body="\`${path}\`: ${body}"
            degraded=$((degraded + 1))
        elif [[ -n "$start_line" && -n "$end_line" && "$start_line" != "$end_line" ]]; then
            # Bitbucket anchors an inline comment to one line; keep the span
            # visible to whoever reads it.
            body="L${start_line}-L${end_line}: ${body}"
            degraded=$((degraded + 1))
        fi

        if [[ "$type_prefix" -eq 1 && "$ctype" != "none" && -n "$ctype" ]]; then
            body="[${ctype}] ${body}"
        fi

        local args
        args=(pr comment "$id" --text "$body")

        if [[ -n "$path" && -n "$start_line" ]]; then
            args+=(--file "$path")
            if [[ "$side" == "old" ]]; then
                args+=(--from-line "$start_line")
            else
                args+=(--to-line "$start_line")
            fi
            [[ "$pending" -eq 1 ]] && args+=(--pending)
        fi

        if [[ "$do_push" -eq 0 ]]; then
            printf 'bkt'
            local a
            for a in "${args[@]}"; do
                printf ' '
                shq "$a"
            done
            printf '\n'
            posted=$((posted + 1))
            continue
        fi

        # Record only real successes, so a re-run finishes a partial push
        # instead of duplicating what already landed.
        if bkt "${args[@]}" >/dev/null; then
            printf '%s\n' "$cid" >> "$ledger"
            posted=$((posted + 1))
        else
            warn "failed to post comment $cid${path:+ ($path${start_line:+:$start_line})}"
            failed=$((failed + 1))
        fi
    done <<< "$comments"

    printf '\n'
    if [[ "$do_push" -eq 0 ]]; then
        info "dry run - nothing was posted. Re-run with --push to execute."
        printf 'would post: %d' "$posted"
    else
        printf 'posted: %d' "$posted"
    fi
    [[ "$skipped"  -gt 0 ]] && printf ', already posted: %d' "$skipped"
    [[ "$degraded" -gt 0 ]] && printf ', degraded: %d' "$degraded"
    [[ "$failed"   -gt 0 ]] && printf ', failed: %d' "$failed"
    printf '\n'

    if [[ "$failed" -gt 0 ]]; then
        error "$failed comment(s) failed to post. Re-run to retry just those."
    fi
    if [[ "$do_push" -eq 1 ]]; then
        success "done. Ledger: $ledger"
    fi
}

main() {
    local cmd="${1:-}"
    case "$cmd" in
        start)        shift; cmd_start "$@" ;;
        push)         shift; cmd_push "$@" ;;
        -h|--help|"") usage ;;
        -v|--version) printf 'tuicr-bb %s\n' "$VERSION" ;;
        *)            printf "${RED}Error:${NC} unknown command: %s\n\n" "$cmd" >&2
                      usage >&2
                      exit 1 ;;
    esac
}

main "$@"
