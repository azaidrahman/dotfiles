#!/bin/bash
# git-credential-op
# Reads git credentials from 1Password via service account token.
# Works locally, over SSH, and in non-login shells (self-sufficient).
#
# Hosts supported:
#   bitbucket.org  →  Gamuda vault         (keychain: op-service-account-token)
#   github.com     →  Personal Development (keychain: op-service-account-token-personal)

load_sa_token() {
  local keychain_entry="$1"
  local token
  token=$(security find-generic-password -a "$USER" -s "$keychain_entry" -w 2>/dev/null)
  if [ -z "$token" ]; then
    echo "error: '$keychain_entry' not found in keychain." \
         "Run: security add-generic-password -a \"\$USER\" -s $keychain_entry -T /usr/bin/security -w <token>" >&2
    exit 1
  fi
  echo "$token"
}

case "$1" in
  get)
    # Parse host from stdin (git credential protocol)
    host=""
    while IFS= read -r line && [ -n "$line" ]; do
      case "$line" in
        host=*) host="${line#host=}" ;;
      esac
    done

    case "$host" in
      bitbucket.org)
        SA_TOKEN=$(load_sa_token "op-service-account-token") || exit 1
        export OP_SERVICE_ACCOUNT_TOKEN="$SA_TOKEN"
        USERNAME=$(op read "op://Gamuda/Bitbucket.Personal_MBP.API_TOKEN/username" 2>/dev/null)
        PASSWORD=$(op read "op://Gamuda/Bitbucket.Personal_MBP.API_TOKEN/credential" 2>/dev/null)
        ;;
      github.com)
        SA_TOKEN=$(load_sa_token "op-service-account-token-personal") || exit 1
        export OP_SERVICE_ACCOUNT_TOKEN="$SA_TOKEN"
        USERNAME=$(op read "op://Personal Development/Aqua.PAT.GH/username" 2>/dev/null)
        PASSWORD=$(op read "op://Personal Development/Aqua.PAT.GH/credential" 2>/dev/null)
        ;;
      *)
        # Unknown host — fall through to next helper
        exit 0
        ;;
    esac

    if [ -z "$PASSWORD" ]; then
      echo "error: failed to read credential for '$host' from 1Password" >&2
      exit 1
    fi

    echo "username=$USERNAME"
    echo "password=$PASSWORD"
    ;;
  store) ;;  # no-op: 1Password is the source of truth
  erase) ;;  # no-op: fix bad tokens in 1Password, not here
esac
