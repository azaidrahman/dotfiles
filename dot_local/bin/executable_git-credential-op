#!/bin/bash
# git-credential-op
# Reads git credentials from 1Password via service account token.
# Works locally, over SSH, and in non-login shells (self-sufficient).

case "$1" in
  get)
    # Load service account token from keychain if not already in env.
    # This makes the helper work in SSH sessions where .zshrc wasn't sourced.
    if [ -z "$OP_SERVICE_ACCOUNT_TOKEN" ]; then
      OP_SERVICE_ACCOUNT_TOKEN=$(
        security find-generic-password \
          -a "$USER" \
          -s "op-service-account-token" \
          -w 2>/dev/null
      )
      export OP_SERVICE_ACCOUNT_TOKEN
    fi

    if [ -z "$OP_SERVICE_ACCOUNT_TOKEN" ]; then
      echo "error: op-service-account-token not found in keychain." \
           "Run: security add-generic-password -a \"\$USER\" -s op-service-account-token -T /usr/bin/security -w <token>" >&2
      exit 1
    fi

    USERNAME=$(op read "op://Gamuda/Bitbucket.Personal_MBP.API_TOKEN/username" 2>/dev/null)
    PASSWORD=$(op read "op://Gamuda/Bitbucket.Personal_MBP.API_TOKEN/credential" 2>/dev/null)

    if [ -z "$PASSWORD" ]; then
      echo "error: failed to read Bitbucket credential from 1Password" >&2
      exit 1
    fi

    echo "username=$USERNAME"
    echo "password=$PASSWORD"
    ;;
  store) ;;  # no-op: 1Password is the source of truth
  erase) ;;  # no-op: fix bad tokens in 1Password, not here
esac
