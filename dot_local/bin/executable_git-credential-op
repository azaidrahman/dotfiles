#!/bin/bash
# git-credential-op
# Reads git credentials with a two-tier strategy:
#   1. Local macOS Keychain cache (fast, offline, survives op rate limits)
#   2. 1Password via service account token (source of truth; refills cache)
#
# Works locally, over SSH, and in non-login shells (self-sufficient).
#
# Hosts supported:
#   bitbucket.org  →  Gamuda vault         (keychain: op-service-account-token)
#   github.com     →  Personal Development (keychain: op-service-account-token-personal)
#
# Item names are derived from the device's LocalHostName (uppercased):
#   github.com     →  <HOST>.PAT.GH                    e.g. AQUA.PAT.GH, ONYX.PAT.GH
#   bitbucket.org  →  Bitbucket.<HOST>.API_TOKEN       e.g. Bitbucket.AQUA.API_TOKEN
#
# Each device needs its own 1Password item. Create one before using this host.
#
# Cache behavior (both hosts):
#   - On 'get': if cached credentials exist in login keychain, use them
#     directly (no 1Password round-trip, no rate-limit risk, works offline).
#       github.com    → caches PAT only; username is the universal
#                       'x-access-token' (works for all PAT types).
#       bitbucket.org → caches PAT *and* username; Bitbucket API-token auth
#                       needs the real username, no universal shortcut.
#   - On successful 1Password fetch: write credentials back into login
#     keychain so the next call is a cache hit. Self-healing — rotates
#     naturally when 1Password is updated.
#   - On 'erase' (git reports auth failure): drop cached entries so the
#     next call forces a fresh read from 1Password.

KEYCHAIN_PATH="$HOME/Library/Keychains/login.keychain-db"

# If the login keychain is locked, prompt for the macOS password on the TTY
# (not via stdin — stdin is busy with git's credential protocol). `security
# unlock-keychain` reads the password via getpass(3), which opens /dev/tty
# directly, so this works mid-credential-exchange.
ensure_keychain_unlocked() {
  if [ ! -e /dev/tty ]; then
    echo "error: login keychain is locked and no TTY available to prompt" >&2
    return 1
  fi
  printf '\n🔒 Login keychain is locked — unlocking for git-credential-op:\n' >/dev/tty
  security unlock-keychain "$KEYCHAIN_PATH" </dev/tty
}

# Does the named entry exist? Cheap check — reading attributes (no -w) works
# even when the keychain is locked, so this distinguishes "missing entry"
# from "exists but unreadable (locked)".
keychain_has() {
  security find-generic-password -a "$USER" -s "$1" >/dev/null 2>&1
}

load_sa_token() {
  local keychain_entry="$1"
  local token

  if ! keychain_has "$keychain_entry"; then
    echo "error: '$keychain_entry' not found in keychain." \
         "Run: security add-generic-password -a \"\$USER\" -s $keychain_entry -T /usr/bin/security -w <token>" >&2
    exit 1
  fi

  token=$(security find-generic-password -a "$USER" -s "$keychain_entry" -w 2>/dev/null)
  if [ -z "$token" ]; then
    ensure_keychain_unlocked || exit 1
    token=$(security find-generic-password -a "$USER" -s "$keychain_entry" -w 2>/dev/null)
  fi
  if [ -z "$token" ]; then
    echo "error: '$keychain_entry' exists but could not be read after unlock" >&2
    exit 1
  fi
  echo "$token"
}

# Read a cached secret from the login keychain. Prints value on stdout if
# found; silent otherwise. If the entry exists but the keychain is locked,
# prompt to unlock so the cache path doesn't silently miss and force a
# 1Password round-trip.
keychain_read() {
  local entry="$1"
  local value
  value=$(security find-generic-password -a "$USER" -s "$entry" -w 2>/dev/null)
  if [ -z "$value" ] && keychain_has "$entry"; then
    ensure_keychain_unlocked >/dev/null 2>&1 || return 0
    value=$(security find-generic-password -a "$USER" -s "$entry" -w 2>/dev/null)
  fi
  [ -n "$value" ] && printf '%s' "$value"
}

# Upsert a secret into the login keychain with ACLs that let git, gh, and
# this script read it without prompting. Idempotent via -U. Silent on error.
keychain_write() {
  local entry="$1"
  local value="$2"
  security add-generic-password \
    -a "$USER" \
    -s "$entry" \
    -w "$value" \
    -T /usr/bin/git \
    -T /usr/bin/security \
    -T /opt/homebrew/bin/gh \
    -U \
    "$HOME/Library/Keychains/login.keychain-db" >/dev/null 2>&1
}

# Resolve this device's short name, uppercased (AQUA, ONYX, ...).
HOST_TAG=$(scutil --get LocalHostName 2>/dev/null || hostname -s)
HOST_TAG=$(printf '%s' "$HOST_TAG" | tr '[:lower:]' '[:upper:]')

case "$1" in
  get)
    # Parse host from stdin (git credential protocol)
    host=""
    while IFS= read -r line && [ -n "$line" ]; do
      case "$line" in
        host=*) host="${line#host=}" ;;
      esac
    done

    case "$host" in
      bitbucket.org)
        # Tier 1: keychain cache. Bitbucket API-token auth needs the real
        # username, so the cache only hits when BOTH entries exist.
        CACHED_PW=$(keychain_read "Bitbucket.${HOST_TAG}.API_TOKEN")
        CACHED_USER=$(keychain_read "Bitbucket.${HOST_TAG}.API_TOKEN.user")
        if [ -n "$CACHED_PW" ] && [ -n "$CACHED_USER" ]; then
          echo "username=$CACHED_USER"
          echo "password=$CACHED_PW"
          exit 0
        fi

        # Tier 2: fall through to 1Password, then refill the cache below.
        SA_TOKEN=$(load_sa_token "op-service-account-token") || exit 1
        export OP_SERVICE_ACCOUNT_TOKEN="$SA_TOKEN"
        ITEM="op://Gamuda/Bitbucket.${HOST_TAG}.API_TOKEN"
        ;;
      github.com)
        # Tier 1: keychain cache. For GitHub PATs any non-empty username is
        # accepted — 'x-access-token' is the convention used by GitHub App
        # tokens and works for classic/fine-grained PATs too.
        CACHED=$(keychain_read "${HOST_TAG}.PAT.GH")
        if [ -n "$CACHED" ]; then
          echo "username=x-access-token"
          echo "password=$CACHED"
          exit 0
        fi

        # Tier 2: fall through to 1Password, then refill the cache below.
        SA_TOKEN=$(load_sa_token "op-service-account-token-personal") || exit 1
        export OP_SERVICE_ACCOUNT_TOKEN="$SA_TOKEN"
        ITEM="op://Personal Development/${HOST_TAG}.PAT.GH"
        ;;
      *)
        # Unknown host — fall through to next helper
        exit 0
        ;;
    esac

    # Read both fields. Capture stderr so we can surface the real cause
    # (rate-limit, missing item, expired token) instead of a generic failure.
    PASSWORD_ERR=$(op read "${ITEM}/credential" 2>&1 >/tmp/.gcop.pw.$$)
    PASSWORD=$(cat /tmp/.gcop.pw.$$ 2>/dev/null)
    rm -f /tmp/.gcop.pw.$$
    USERNAME=$(op read "${ITEM}/username" 2>/dev/null)

    if [ -z "$PASSWORD" ]; then
      echo "error: failed to read credential for '$host' from 1Password (item: ${ITEM})" >&2
      if [ -n "$PASSWORD_ERR" ]; then
        echo "       op said: ${PASSWORD_ERR}" >&2
      fi
      echo "       if missing: create the item in the matching vault" >&2
      echo "       if rate-limited: wait and retry" >&2
      echo "       if token rejected: run 'op-sa-health' to check SA token" >&2
      exit 1
    fi

    # Self-healing cache: on a successful op fetch, write credentials back
    # into login keychain so the next call is a cheap cache hit.
    case "$host" in
      github.com)
        keychain_write "${HOST_TAG}.PAT.GH" "$PASSWORD" || true
        ;;
      bitbucket.org)
        keychain_write "Bitbucket.${HOST_TAG}.API_TOKEN" "$PASSWORD" || true
        keychain_write "Bitbucket.${HOST_TAG}.API_TOKEN.user" "$USERNAME" || true
        ;;
    esac

    echo "username=$USERNAME"
    echo "password=$PASSWORD"
    ;;
  store) ;;  # no-op: 1Password is the source of truth; 'get' populates cache
  erase)
    # Git calls this when a credential it was handed failed (e.g. rotated
    # PAT or API token). Invalidate the local cache so the next 'get' pulls
    # a fresh value from 1Password.
    host=""
    while IFS= read -r line && [ -n "$line" ]; do
      case "$line" in
        host=*) host="${line#host=}" ;;
      esac
    done
    case "$host" in
      github.com)
        security delete-generic-password -a "$USER" -s "${HOST_TAG}.PAT.GH" >/dev/null 2>&1 || true
        ;;
      bitbucket.org)
        security delete-generic-password -a "$USER" -s "Bitbucket.${HOST_TAG}.API_TOKEN" >/dev/null 2>&1 || true
        security delete-generic-password -a "$USER" -s "Bitbucket.${HOST_TAG}.API_TOKEN.user" >/dev/null 2>&1 || true
        ;;
    esac
    ;;
esac
