#!/bin/sh
# git-sign — SSH commit-signing shim. Signs with the key already in the session
# ssh-agent (zero prompts). If the key isn't loaded, it's pulled HEADLESSLY from
# 1Password via the matching service-account token (no Touch ID) and added with a
# 12h lifetime, then ssh-keygen signs against the agent. If the key can't be
# loaded (offline / no token), falls back to 1Password's op-ssh-sign so a commit
# never fails. Verification and any non-sign calls pass straight to ssh-keygen.
#
# git hands the signing public key via `-f <keyfile>`; we route by that key:
#   …IM03J8…  personal → op-service-account-token-personal · Signing.GH.HOME (GitHub)
#   …IK+RKQ…  work     → op-service-account-token          · Signing.BB.GD  (Bitbucket)

set -u
OP_SIGN="/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

# Only intervene on a sign request; verify/find-principals/etc. pass through.
case " $* " in
  *" -Y sign "*) ;;
  *) exec ssh-keygen "$@" ;;
esac

# Locate the -f <keyfile> git passed and read its public-key blob (base64 field).
keyfile=""; prev=""
for a in "$@"; do
  [ "$prev" = "-f" ] && { keyfile="$a"; break; }
  prev="$a"
done
blob=""
[ -n "$keyfile" ] && [ -f "$keyfile" ] && blob=$(awk '{print $2; exit}' "$keyfile" 2>/dev/null)

# Map the requested key to its 1Password source.
sa_entry=""; op_ref=""
case "$blob" in
  AAAAC3NzaC1lZDI1NTE5AAAAIM03J8pvVltYwxTbBkr3*)
    sa_entry="op-service-account-token-personal"
    op_ref="op://Personal Development/Signing.GH.HOME/private key?ssh-format=openssh" ;;
  AAAAC3NzaC1lZDI1NTE5AAAAIK+RKQKLiD4MzerLtLj*)
    sa_entry="op-service-account-token"
    op_ref="op://Gamuda/Signing.BB.GD/private key?ssh-format=openssh" ;;
esac

# If we recognize the key and it isn't in the agent, load it headlessly.
if [ -n "$blob" ] && [ -n "$sa_entry" ] && ! ssh-add -L 2>/dev/null | grep -qF "$blob"; then
  sa=$(security find-generic-password -a "$USER" -s "$sa_entry" -w 2>/dev/null)
  if [ -n "$sa" ]; then
    OP_SERVICE_ACCOUNT_TOKEN="$sa" op read "$op_ref" 2>/dev/null | ssh-add -t 43200 - >/dev/null 2>&1
  fi
fi

# Sign via the agent if the key is present; otherwise fall back to 1Password.
if [ -n "$blob" ] && ssh-add -L 2>/dev/null | grep -qF "$blob"; then
  exec ssh-keygen "$@"
fi
[ -x "$OP_SIGN" ] && exec "$OP_SIGN" "$@"
exec ssh-keygen "$@"
